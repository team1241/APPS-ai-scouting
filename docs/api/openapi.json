{
  "openapi": "3.1.0",
  "info": {
    "title": "Organization Scouting Data API",
    "version": "1.1.0",
    "description": "Read-only, tenant-scoped current extraction results for match, pit and general scouting. Availability follows asynchronous extraction. No scouting writes, raw messages, identities, history or calculated statistics. See docs/api/README.md for pagination and freshness semantics."
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "security": [
    {
      "ApiKey": []
    }
  ],
  "paths": {
    "/organization": {
      "get": {
        "summary": "Check the organization bound to this key",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "organization": {
                      "$ref": "#/components/schemas/Organization"
                    }
                  },
                  "required": ["organization"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path/query/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent in this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-key rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Verification, provider quota, configuration or database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/teams/{teamNumber}/events": {
      "get": {
        "summary": "List events with currently extracted observations for this team",
        "parameters": [
          {
            "name": "teamNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path/query/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent in this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-key rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Verification, provider quota, configuration or database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/observations": {
      "get": {
        "summary": "Read current observations for all teams at one event",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path/query/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent in this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-key rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Verification, provider quota, configuration or database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/teams/{teamNumber}/observations": {
      "get": {
        "summary": "Read current observations for one team at one event",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "teamNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 999999
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObservationPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid path/query/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent in this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-key rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Verification, provider quota, configuration or database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/events/{eventId}/specifications/{version}": {
      "get": {
        "summary": "Discover question meanings for a published specification version",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Observation kind of the publication. Versions are numbered per kind. Default match.",
            "schema": {
              "enum": ["match", "pit", "general"],
              "default": "match"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "specification": {
                      "$ref": "#/components/schemas/Specification"
                    }
                  },
                  "required": ["specification"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid path/query/cursor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent in this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Per-key rate limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Verification, provider quota, configuration or database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": ["error"]
      },
      "Organization": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "teamNumber": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["id", "name", "teamNumber"]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "season": {
            "type": "integer"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "timezone": {
            "type": "string"
          },
          "eventCode": {
            "type": ["string", "null"],
            "description": "FIRST event code when available, otherwise the TBA event key; null for events without either identifier."
          }
        },
        "required": ["id", "name", "season", "startDate", "endDate", "timezone", "eventCode"]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^obs_[0-9a-f]{64}$"
          },
          "teamNumber": {
            "type": ["integer", "null"],
            "minimum": 1,
            "description": "Required for match and pit observations. A general note may have no team."
          },
          "kind": {
            "enum": ["match", "pit", "general"]
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": ["string", "null"],
                "format": "uuid"
              },
              "label": {
                "type": ["string", "null"],
                "description": "Qualification labels use Q<number> in both match.label and values.match. Playoff labels retain their stage identity; unknown labels and null remain unresolved."
              },
              "resolved": {
                "type": "boolean"
              }
            },
            "required": ["id", "label", "resolved"],
            "description": "Pit observations never have a match. General observations may."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "specificationVersion": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "type": ["string", "number", "boolean", "array", "null"],
              "items": {
                "type": "string"
              }
            },
            "description": "One entry per question of the observation's publication. Only current answers have a value: unknown, invalid and inactive (hidden by a rule) answers are null. Explicit false, numeric 0 and [] are answers. Choice answers are option codes. Extracted notes may contain incidental personal information."
          },
          "completeness": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": ["complete", "incomplete"]
              },
              "missing": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": ["status", "missing"]
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": ["off", "warn", "strict", "unknown"]
              },
              "status": {
                "enum": [
                  "off",
                  "valid",
                  "missing_identity",
                  "missing_schedule",
                  "stale_schedule",
                  "ambiguous_match",
                  "unknown_match",
                  "invalid_pairing",
                  "incomplete_participants",
                  "not_applicable",
                  "unknown"
                ]
              }
            },
            "required": ["mode", "status"]
          },
          "event": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "code", "label"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "code": {
                "type": ["string", "null"],
                "description": "FIRST event code when available, otherwise the TBA event key; null for events without either identifier."
              },
              "label": {
                "type": "string",
                "description": "Event name."
              }
            }
          },
          "fields": {
            "type": "object",
            "description": "State of each question, so null values can be told apart: missing (required, unknown), unanswered (optional, unknown), invalid, pending (applicability unknown), inactive (hidden by a rule; any earlier answer is excluded from values).",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "enum": ["answered", "unanswered", "missing", "invalid", "pending", "inactive"]
                },
                "requirement": {
                  "enum": ["required", "optional", "unknown", "not_applicable"]
                }
              },
              "required": ["state", "requirement"]
            }
          }
        },
        "required": [
          "id",
          "teamNumber",
          "kind",
          "match",
          "updatedAt",
          "specificationVersion",
          "values",
          "completeness",
          "validation",
          "event",
          "fields"
        ]
      },
      "Specification": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "type": {
                  "enum": ["text", "integer", "boolean"]
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": ["key", "type", "required", "description"]
            },
            "description": "Format 1 publications only. Kept for existing integrations; use questions."
          },
          "kind": {
            "enum": ["match", "pit", "general"]
          },
          "formatVersion": {
            "type": ["integer", "null"],
            "description": "Contract format. 1 is the original starter format, 2 the customizable contract."
          },
          "questions": {
            "type": "array",
            "description": "Questions in follow-up order. Answer constraints and rules use the shared contract format; see docs/scouting-contract.md.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean",
                  "description": "Base requirement before rules apply."
                },
                "answer": {
                  "type": "object",
                  "description": "Answer type and constraints."
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              "required": ["key", "label", "required", "answer"]
            }
          }
        },
        "required": ["version", "kind", "formatVersion", "description", "questions"]
      },
      "EventPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Event"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "ObservationPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Observation"
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      }
    }
  }
}
