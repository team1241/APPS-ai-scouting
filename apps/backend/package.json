{
  "name": "@ai-scouting/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:sync && node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc",
    "db:generate": "kysely-codegen --dialect postgres --env-file .env --default-schema public --out-file src/db.generated.ts --include-pattern \"public.*\" --exclude-pattern \"public.kysely_*\"",
    "db:types:check": "pnpm db:generate --verify",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.ts",
    "db:sync": "pnpm db:migrate && pnpm db:generate",
    "schedule:sync": "node --env-file-if-exists=.env src/schedule-sync.ts"
  },
  "dependencies": {
    "@ai-scouting/scouting": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "windows-iana": "5.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "kysely-codegen": "^0.20.0",
    "typescript": "^7.0.2"
  }
}
