PORT=3000
# Neon pooled connection string
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Local enroll fixture only; never used for routing or worker selection.
TELEGRAM_ORGANIZATION_ID=
ALLOW_LOCAL_TELEGRAM_ENROLL=false

# Local extraction worker; requires local Mastra and model key.
EXTRACTION_ENABLED=false
MASTRA_URL=http://127.0.0.1:4111

# Shared app credential for backend-to-Mastra extraction only.
MASTRA_SERVICE_TOKEN=

# FIRST FRC Events API account (server-side only).
FRC_EVENTS_USERNAME=
FRC_EVENTS_AUTHORIZATION_KEY=

# Supplemental TBA Read API credential (server-side only).
TBA_AUTH_KEY=
# Schedule polling runs in a separate Railway cron service every 10 minutes.
# Start command: pnpm --filter @ai-scouting/backend schedule:sync
# Uses DATABASE_URL, TELEGRAM_BOT_TOKEN and provider keys above.

# Clerk browser-session verification (same instance as apps/web).
CLERK_SECRET_KEY=
CLERK_ISSUER=
# Optional public PEM key for offline signature verification instead of JWKS fetch.
CLERK_JWT_KEY=
# Exact allowed app origins, comma-separated. Never wildcard preview domains.
WEB_ORIGINS=http://localhost:3001

# on (default): poll continuously; auto: attended event dates + 2-minute webhook bursts;
# off: pause extraction/delivery claims while preserving intake and queued work.
EVENT_MODE=auto
# For retry recovery while the HTTP service sleeps, configure a separate Railway cron:
# pnpm --filter @ai-scouting/backend worker:run, */10 * * * *
# Use the same EVENT_MODE override on all backend/cron services.

# Organization API keys (Unkey API Management, free tier). Leave empty to disable keys.
# Root key permissions: api.<UNKEY_API_ID>.create_key, delete_key, verify_key.
UNKEY_ROOT_KEY=
UNKEY_API_ID=
# 32 random bytes, base64. Encrypts stored keys so admins can view them again.
# Generate with: openssl rand -base64 32. Changing it makes stored keys unreadable.
API_KEY_ENCRYPTION_KEY=
# Requests per minute for each new key.
API_KEY_RATE_LIMIT_PER_MINUTE=60
