{
  "name": "ai-scouting",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @ai-scouting/backend db:generate",
    "db:types:check": "pnpm --filter @ai-scouting/backend db:types:check",
    "db:migrate": "pnpm --filter @ai-scouting/backend db:migrate",
    "db:sync": "pnpm --filter @ai-scouting/backend db:sync",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "node --test --test-concurrency=1",
    "test:build-compat": "node --test scripts/mastra-lockfile.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4"
  }
}
